# Required for Solar model calls. Enter the value after '=' in your local .env.
# Never commit .env or paste the value into logs, issues, or prompts.
# A global macOS Keychain value can instead be saved with: sol --set-api-key
UPSTAGE_API_KEY=

# Optional. Leave empty to use the keyless Naver and Mojeek fallback chain.
# Global secure input: sol --set-tinyfish-api-key
TINYFISH_API_KEY=

# Optional: force one provider for reproducible local runs.
# SOL_SEARCH_PROVIDER=auto  # auto, tinyfish, naver, or mojeek

# Optional: override the OpenAI-compatible chat completion endpoint.
# SOL_API_URL=https://api.upstage.ai/v1/chat/completions

# Optional: override the default model for local testing.
# SOL_MODEL=solar-open2
